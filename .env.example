DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_MONTHLY_BUDGET_CNY=30
DEEPSEEK_PRO_DAILY_LIMIT=10
# Key、飞书资料和富途登录资料在中文面板中填写。
# 固定管理口令时再设置此值；留空时首次启动自动生成。
SETUP_TOKEN=

# Discord 采集：优先使用用户 Token 调官方 REST API 读取频道历史（最稳定）。
# 填写后不再依赖浏览器抓取 DOM。token 只保存在本机配置，不会入库。
DISCORD_USER_TOKEN=

# 飞书通知：二选一。
# 1) 最简单的群机器人 webhook（推荐先试这个，无需 App 凭据、无需绑定）。
FEISHU_WEBHOOK_URL=
# 2) 自建应用模式：需要 App ID/Secret 并在飞书开放平台开启事件订阅（长连接）。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
