# options-radar 部署环境变量（复制为 .env 后按需修改）
# 所有项都有默认值，可整份保留不动。

# 容器内时区
TZ=Asia/Shanghai

# 宿主机端口：面板会暴露在 http://<NAS_IP>:<HOST_PORT>
HOST_PORT=8787

# ── 代理（中国大陆访问 Discord / OpenD 下载时按需填写）──
# 容器内 OpenD 下载与 Discord REST 采集会自动读取这两个变量。
# 示例：宿主机 Clash/v2ray 代理为 http://192.168.1.5:7890
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# ── 密钥（可选）──
# 默认在面板「设置」页填写密钥，会安全写入 /data/secrets/（不进 config.yaml）。
# 若想在容器编排层注入，可指向宿主机上的密钥文件：
# DEEPSEEK_API_KEY_FILE=/path/to/deepseek_key
# FEISHU_APP_SECRET_FILE=/path/to/feishu_secret
# DISCORD_USER_TOKEN_FILE=/path/to/discord_token
# FUTU 登录密码仅通过面板设置页填写（只持久化 OpenD 协议的 MD5 形式）。
